@namespace Orchid.Mobile.Component
@using Garden.Share
@using Orchid.Core.Login
@inject OrchidLoginOutcomeHandler Outcome
@implements IDisposable

<LoginScreen Branding="_branding">
    <ProgressIndicator>
        <GardenLoadingIndicator />
    </ProgressIndicator>
</LoginScreen>

@code {
    private readonly LoginBranding _branding = OrchidLoginBranding.Create();

    /// <summary>
    /// 로그인 완료 시 부모 컴포넌트에 상태 갱신을 알리는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }

    protected override void OnInitialized()
    {
        Outcome.Authenticated += NotifyAuthenticatedAsync;
    }

    private Task NotifyAuthenticatedAsync()
    {
        return InvokeAsync(() => OnAuthenticated.InvokeAsync());
    }

    /// <summary>
    /// 컴포넌트 해제 시 로그인 결과 구독을 정리합니다.
    /// </summary>
    public void Dispose()
    {
        Outcome.Authenticated -= NotifyAuthenticatedAsync;
    }
}
