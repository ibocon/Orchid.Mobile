@namespace Orchid.Mobile.Component
@inject Orchid.Mobile.Service.IQrPairingScanner PairingScanner

<GardenCard Type="GardenCardType.Elevated" Style="padding: 16px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center;">
    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="MudSize.Large" />
    <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Title" Size="TypographySize.Medium">
        디바이스 페어링
    </GardenTypography>
    <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
        데스크톱 화면의 QR 코드를 스캔하거나 페어링 키를 입력하세요.
    </GardenTypography>
    <GardenButton Variant="GardenButtonVariant.Filled" Size="GardenButtonSize.Small" OnClick="ScanAsync">
        QR 코드 스캔
    </GardenButton>
    <GardenTextField @bind-Value="_manualKey" Label="데스크톱 페어링 키 입력" />
    <GardenButton Variant="GardenButtonVariant.Filled" Size="GardenButtonSize.Small" OnClick="SubmitAsync">
        연결
    </GardenButton>
    <QrPairingCode />
</GardenCard>

@code {
    private string? _manualKey;

    /// <summary>
    /// QR 코드 스캔 또는 수동 입력 성공 시 페어링 키를 전달하는 콜백
    /// </summary>
    [Parameter]
    public EventCallback<string> OnQrScanned { get; set; }

    private Task SubmitAsync()
    {
        return string.IsNullOrWhiteSpace(_manualKey)
            ? Task.CompletedTask
            : OnQrScanned.InvokeAsync(_manualKey.Trim());
    }

    private async Task ScanAsync()
    {
        string? payload = await PairingScanner.ScanAsync();
        if (!string.IsNullOrWhiteSpace(payload))
        {
            await OnQrScanned.InvokeAsync(payload);
        }
    }
}
