@namespace Orchid.Mobile.Component

<GardenCard Type="GardenCardType.Outlined" Style="padding: 16px; margin-bottom: 8px; display: flex; flex-direction: column; gap: 8px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <GardenChipAssist Label="@ContentType.ToString()" Variant="GardenChipAssistVariant.Elevated" />
        <div style="display: flex; gap: 4px;">
            <GardenIconButton Icon="@Icons.Material.Filled.PushPin"
                              Variant="GardenIconButtonVariant.Standard"
                              Size="GardenIconButtonSize.Small"
                              OnClick="@(_ => OnPinClick.InvokeAsync())" />
            <GardenIconButton Icon="@Icons.Material.Filled.Delete"
                              Variant="GardenIconButtonVariant.Standard"
                              Size="GardenIconButtonSize.Small"
                              OnClick="@(_ => OnDeleteClick.InvokeAsync())" />
        </div>
    </div>
    <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
        @PreviewText
    </GardenTypography>
</GardenCard>

@code {
    /// <summary>
    /// 클립보드 데이터의 콘텐츠 형식
    /// </summary>
    [Parameter]
    public ContentType ContentType { get; set; } = ContentType.Text;

    /// <summary>
    /// 표시할 미리보기 텍스트
    /// </summary>
    [Parameter]
    public string PreviewText { get; set; } = string.Empty;

    /// <summary>
    /// 고정 이벤트 콜백
    /// </summary>
    [Parameter]
    public EventCallback OnPinClick { get; set; }

    /// <summary>
    /// 삭제 이벤트 콜백
    /// </summary>
    [Parameter]
    public EventCallback OnDeleteClick { get; set; }
}
