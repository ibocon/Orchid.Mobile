@namespace Orchid.Mobile.Component

<GardenCard Type="GardenCardType.Elevated" Style="padding: 24px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;">
    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="MudSize.Large" />
    <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Title" Size="TypographySize.Medium">
        디바이스 페어링
    </GardenTypography>
    <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
        데스크톱 화면에 표시된 페어링 키를 입력하세요.
    </GardenTypography>
    <GardenTextField @bind-Value="_manualKey" Label="페어링 키 직접 입력" />
    <GardenButton Variant="GardenButtonVariant.Filled" Size="GardenButtonSize.Small" OnClick="SubmitAsync">
        연결
    </GardenButton>
</GardenCard>

@code {
    private string? _manualKey;

    /// <summary>
    /// QR 코드 스캔 또는 수동 입력 성공 시 페어링 키를 전달하는 콜백
    /// </summary>
    [Parameter]
    public EventCallback<string> OnQrScanned { get; set; }

    private Task SubmitAsync()
    {
        return string.IsNullOrWhiteSpace(_manualKey)
            ? Task.CompletedTask
            : OnQrScanned.InvokeAsync(_manualKey.Trim());
    }
}
