@namespace Orchid.Mobile.Component

<GardenTopAppBar Height="14" PaddingHorizontal="3" PaddingVertical="1">
    <LeadingContent>
        <MudIcon Icon="@Icons.Material.Filled.ContentPasteGo" Style="margin-right: var(--gdn-sys-spacing-2);" />
        <GardenTypography HtmlTag="h1" Typo="TypographyStyle.Title" Size="TypographySize.Medium">
            Universal Clipboard Bridge
        </GardenTypography>
    </LeadingContent>
    <TrailingContent>
        <GardenChipAssist Icon="@(IsConnected ? Icons.Material.Filled.Sync : Icons.Material.Filled.SyncDisabled)"
                          Label="@(IsConnected ? "동기화 중" : "오프라인")"
                          Variant="GardenChipAssistVariant.Outlined" />
    </TrailingContent>
</GardenTopAppBar>

@code {
    /// <summary>
    /// 백엔드 릴레이 서버와의 실시간 연결 상태를 나타냅니다.
    /// </summary>
    [Parameter]
    public bool IsConnected { get; set; } = true;
}
