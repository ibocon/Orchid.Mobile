@namespace Orchid.Mobile.Component
@inject IStringLocalizer<MobileHeaderResource> Localizer

<GardenTopAppBar Height="16"
                 PaddingHorizontal="3"
                 PaddingVertical="1">
    <LeadingContent>
        <MudIcon Icon="@Icons.Material.Filled.ContentPasteGo"
                 Style="margin-right: var(--gdn-sys-spacing-2);" />
        <GardenTypography HtmlTag="h1"
                          Typo="TypographyStyle.Title"
                          Size="TypographySize.Medium"
                          Style="margin-right: var(--gdn-sys-spacing-2); font-weight: 600; white-space: nowrap;">
            @Localizer[nameof(MobileHeaderResource.AppTitle)]
        </GardenTypography>
    </LeadingContent>
    <TrailingContent>
        <div style="display: flex; align-items: center; gap: 8px;">
            <GardenChipAssist Icon="@(IsConnected ? Icons.Material.Filled.Sync : Icons.Material.Filled.SyncDisabled)"
                              Label="@(IsConnected ? Localizer[nameof(MobileHeaderResource.SyncingLabel)] : Localizer[nameof(MobileHeaderResource.OfflineLabel)])"
                              Variant="GardenChipAssistVariant.Outlined" />
            <GardenIconButton Variant="GardenIconButtonVariant.Standard"
                              Size="GardenIconButtonSize.Small"
                              Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                              OnClick="OnToggleTheme"
                              aria-label="@Localizer[nameof(MobileHeaderResource.ToggleThemeLabel)]"
                              title="@Localizer[nameof(MobileHeaderResource.ToggleThemeLabel)]" />
            @if (IsAuthenticated)
            {
                <GardenAccountMenu DisplayName="@UserName"
                                   Email="@UserEmail"
                                   SignOutLabel="@Localizer[nameof(MobileHeaderResource.SignOutLabel)]"
                                   OnSignOutRequested="OnSignOut" />
            }
        </div>
    </TrailingContent>
</GardenTopAppBar>

@code {
    /// <summary>
    /// 백엔드 릴레이 서버와의 실시간 연결 상태를 나타냅니다.
    /// </summary>
    [Parameter]
    public bool IsConnected { get; set; } = true;

    /// <summary>
    /// 현재 사용자의 인증 여부를 나타냅니다.
    /// </summary>
    [Parameter]
    public bool IsAuthenticated { get; set; }

    /// <summary>
    /// 현재 사용자의 표시 이름입니다.
    /// </summary>
    [Parameter]
    public string? UserName { get; set; }

    /// <summary>
    /// 현재 사용자의 이메일 주소입니다.
    /// </summary>
    [Parameter]
    public string? UserEmail { get; set; }

    /// <summary>
    /// 현재 다크 모드 여부를 나타냅니다.
    /// </summary>
    [Parameter]
    public bool IsDarkMode { get; set; }

    /// <summary>
    /// 테마 전환 요청 시 호출되는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnToggleTheme { get; set; }

    /// <summary>
    /// 로그아웃 요청 시 호출되는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnSignOut { get; set; }
}
