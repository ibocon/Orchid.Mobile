@namespace Orchid.Mobile.Component
@using Orchid.Mobile.Service
@inject IOrchidMobileAuthService AuthService

<GardenCard Type="GardenCardType.Elevated"
            Style="max-width: 420px; margin: 24px auto; padding: 28px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;">
    <MudIcon Icon="@Icons.Material.Filled.LockPerson" Size="MudSize.Large" />
    <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Headline" Size="TypographySize.Small">
        Universal Clipboard Bridge 로그인
    </GardenTypography>
    <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
        계정으로 로그인하여 PC와 모바일 간 Zero-Knowledge E2EE 클립보드 동기화를 시작하세요.
    </GardenTypography>

    <div style="display: flex; flex-direction: column; gap: 12px; width: 100%; align-items: center; margin-top: 8px;">
        <GoogleLoginButton Width="280px"
                           Height="48px"
                           BorderRadius="12px"
                           Text="Google 계정으로 계속하기"
                           OnClick="@(() => SignInAsync("google"))" />
        <KakaoLoginButton Width="280px"
                          Height="48px"
                          BorderRadius="12px"
                          Text="카카오 계정으로 계속하기"
                          OnClick="@(() => SignInAsync("kakao"))" />
        <MicrosoftLoginButton Width="280px"
                              Height="48px"
                              BorderRadius="12px"
                              Text="Microsoft 계정으로 계속하기"
                              OnClick="@(() => SignInAsync("microsoft"))" />
    </div>
</GardenCard>

@code {
    /// <summary>
    /// 로그인 완료 시 부모 컴포넌트에 상태 갱신을 알리는 콜백입니다.
    /// </summary>
    [Parameter]
    public EventCallback OnAuthenticated { get; set; }

    private async Task SignInAsync(string provider)
    {
        await AuthService.SignInWithProviderAsync(provider);
        await OnAuthenticated.InvokeAsync();
    }
}
