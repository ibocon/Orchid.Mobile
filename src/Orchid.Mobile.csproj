<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) and '$(OrchidAndroidOnlyPublish)' != 'true'">net10.0-android;net10.0-ios</TargetFrameworks>
    <RuntimeIdentifiers Condition="'$(OrchidAndroidOnlyPublish)' == 'true'">android-arm64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orchid.Mobile</RootNamespace>
    <ApplicationTitle>Universal Clipboard Bridge</ApplicationTitle>
    <ApplicationId>com.botanicsoft.orchid</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Desktop과 같은 기본값과 같은 덮어쓰기 규칙 -->
    <OrchidRelayUrl Condition="'$(OrchidRelayUrl)' == ''">https://stag.botanicsoft.com/orchid</OrchidRelayUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OrchidRelayUrl</_Parameter1>
      <_Parameter2>$(OrchidRelayUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Orchid.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Garden.Razor" />
    <PackageReference Include="Garden.Share" />
  </ItemGroup>
</Project>
