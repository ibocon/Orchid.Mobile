<?xml version="1.0" encoding="utf-8" ?>
<garden:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:garden="clr-namespace:Garden.Maui;assembly=Garden.Maui"
                 xmlns:b="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
                 xmlns:component="clr-namespace:Orchid.Mobile.Component"
                 xmlns:local="clr-namespace:Orchid.Mobile"
                 x:Class="Orchid.Mobile.MainPage"
                 x:DataType="local:MainViewModel"
                 x:TypeArguments="local:MainViewModel">

    <b:BlazorWebView HostPage="wwwroot/index.html">
        <b:BlazorWebView.RootComponents>
            <b:RootComponent Selector="#app" ComponentType="{x:Type component:MobileApp}" />
        </b:BlazorWebView.RootComponents>
    </b:BlazorWebView>

</garden:BasePage>
